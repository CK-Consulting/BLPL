# Copy to .env (repo root) and app/.env, then fill in what you need.
#
# TWO files, on purpose. `docker compose -f app/docker-compose.yml` reads its
# project directory — app/ — so the container's variables come from app/.env.
# The repo-root .env is for running the CLI and the tests outside Docker. They
# are not the same file and neither is loaded for the other.
#
# Everything here is optional. The app starts with an empty .env; each block
# below says what you lose without it.
#
# NEITHER FILE BELONGS IN GIT. Both are covered by .gitignore — the root .env was
# tracked until 2026-08-15 and had to be scrubbed out of history, which is why
# this example exists instead.


# --- LLM providers ---------------------------------------------------------
#
# Only needed for the stages that call a model (stage0-llm, stage1, the review
# panel). A key here is a *fallback*: one stored in the app's Settings screen
# wins, and is the better place for anything real — a vaulted key is encrypted
# at rest and is handed only to the stages that need it, whereas everything in
# this file is plaintext on disk, visible to `docker inspect`, and inherited by
# every stage subprocess. See docs/install.md.
#
# For two endpoints of the same kind (two Anthropic accounts, say), one shared
# variable cannot tell them apart — use BLPL_LLM_KEY__<ENDPOINT> instead, named
# for the endpoint in blpl.toml, uppercased with - and . becoming _.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Not a key — an address. ollama never takes a key. Inside the container
# `localhost` is the container, so point at the host:
# OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_HOST=

# Where the CLI keeps working copies when run outside Docker.
BLPL_WORKSPACE=


# --- Sign-in with GitLab / GitHub / Google (optional) ----------------------
#
# Leave all of this empty and the app's front door is the passphrase, which is a
# complete setup. Enabling SSO wraps the vault key under a server-held key, so
# from then on the data directory alone is enough to read your secrets — see the
# vault section of docs/install.md before turning it on.
#
# BLPL_PUBLIC_URL must be the origin the *browser* uses. Behind nginx the backend
# sees http://backend:8000, and a redirect_uri that doesn't match what you
# registered with the provider is the usual reason a login fails.
BLPL_PUBLIC_URL=
# 32 bytes, base64 or hex. Generated at $BLPL_DATA_ROOT/server.key if unset.
# Do not store it in the same backup as vault.db — together they are the lock
# and its key. Generate one with:
#   python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).rstrip(b'=').decode())"
BLPL_SERVER_KEY=

# NOT OPTIONAL once any provider below is set. Without an allowlist, anyone with
# an account at that provider could open your vault, so SSO stays switched off
# until one of these is non-empty. Comma-separated.
BLPL_OAUTH_ALLOWED_EMAILS=
BLPL_OAUTH_ALLOWED_DOMAINS=

# Redirect URI to register: https://<your-host>/api/auth/oauth/gitlab/callback
BLPL_OAUTH_GITLAB_CLIENT_ID=
BLPL_OAUTH_GITLAB_CLIENT_SECRET=

# A company GitLab, alongside gitlab.com rather than instead of it. The issuer is
# required — without it there is no discovery document to read.
BLPL_OAUTH_GITLAB_SELF_CLIENT_ID=
BLPL_OAUTH_GITLAB_SELF_CLIENT_SECRET=
BLPL_OAUTH_GITLAB_SELF_ISSUER=

# GitHub is not an OIDC provider, so it reads your primary verified address from
# api.github.com/user/emails. An account without one cannot sign in.
BLPL_OAUTH_GITHUB_CLIENT_ID=
BLPL_OAUTH_GITHUB_CLIENT_SECRET=

BLPL_OAUTH_GOOGLE_CLIENT_ID=
BLPL_OAUTH_GOOGLE_CLIENT_SECRET=


# --- Supplier lookups (optional) -------------------------------------------
#
# For kicad-happy's datasheet and quote features. Without them LCSC still works
# (it reads a public endpoint); the others are skipped and say so.
#
# DigiKey uses the two-legged client_credentials grant, so the ID and secret are
# enough — there is no redirect step. The _OAUTH_ spelling is DigiKey's portal
# naming; blpl.agent.kicad_happy._CRED_MAP aliases it to the DIGIKEY_CLIENT_*
# names the scripts actually read.
DIGIKEY_OAUTH_CLIENT_ID=
DIGIKEY_OAUTH_CLIENT_SECRET=
# Not read at runtime. Kept because developer.digikey.com demands a redirect URI
# at registration, and a three-legged flow would need the real one.
DIGIKEY_CALLBACK_URL=

# Quoting needs only the search key. The orders key is passed through and
# currently unread — held for ordering work beyond what kicad-happy does.
MOUSER_SEARCH_API_KEY=
MOUSER_ORDERS_API_KEY=

ELEMENT14_API_KEY=
