# Copy to .env (repo root) and app/.env, then fill in what you need.
#
# TWO files, on purpose. `docker compose -f app/docker-compose.yml` reads its
# project directory — app/ — so the container's variables come from app/.env.
# The repo-root .env is for running the CLI and the tests outside Docker. They
# are not the same file and neither is loaded for the other.
#
# Everything here is optional. The app starts with an empty .env; each block
# below says what you lose without it.
#
# NEITHER FILE BELONGS IN GIT. Both are covered by .gitignore — the root .env was
# tracked until 2026-08-15 and had to be scrubbed out of history, which is why
# this example exists instead.


# --- LLM providers ---------------------------------------------------------
#
# For the CLI only. The hosted app does NOT read these: keys there belong to a
# signed-in user and are added through Settings, because a shared key here would
# mean every user of a deployment spending the operator's quota on the
# operator's account. Setting them changes nothing about what the app does.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Not a key — an address. ollama never takes a key. Inside the container
# `localhost` is the container, so point at the host:
# OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_HOST=

# Where the CLI keeps working copies when run outside Docker.
BLPL_WORKSPACE=


# --- Signing in (Clerk) ----------------------------------------------------
#
# The instance the backend verifies session tokens against. It MUST match the
# publishable key the frontend was built with — the backend pins the issuer,
# because a correctly-signed token from anyone else's Clerk instance is
# otherwise indistinguishable from one of ours, and anyone can create one.
# Get both from `clerk init`; the issuer is derivable from the publishable key.
BLPL_CLERK_ISSUER=

# Read by Vite at BUILD time, so it reaches the image as a build arg. Changing
# it needs a rebuild, not a restart. Not a secret — it identifies the instance
# to the browser and is readable in any built bundle.
VITE_CLERK_PUBLISHABLE_KEY=


# --- The key that seals stored provider keys -------------------------------
#
# 32 bytes, base64 or hex. Generated at $BLPL_DATA_ROOT/server.key on first boot
# if left empty. Generate one by hand with:
#   python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).rstrip(b'=').decode())"
#
# A database dump alone is inert; a dump plus this key is every user's provider
# keys. Do not keep it in the same backup as the database, and do not lose it —
# every stored key becomes unreadable and has to be re-entered.
BLPL_SERVER_KEY=


# --- Who the containers run as (app/.env, REQUIRED) -------------------------
#
# The uid and gid that own app/data on the host. Backend and worker run as this
# user, and the KiCad desktop's PUID/PGID follow it, so everything a run writes
# is editable and committable from the host without sudo. Compose refuses to
# start without them rather than defaulting to root. Baked into the image as
# build args, so changing them needs a rebuild. Fill in with `id -u` / `id -g`.
# After first switching from root, run app/fix-data-ownership.sh once.
BLPL_UID=
BLPL_GID=


# --- Postgres --------------------------------------------------------------
#
# Defaults match the compose service, so a plain `docker compose up` works with
# none of these set. Change them for anything exposed.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=


# --- Supplier lookups (optional) -------------------------------------------
#
# For kicad-happy's datasheet and quote features. Without them LCSC still works
# (it reads a public endpoint); the others are skipped and say so.
#
# DigiKey uses the two-legged client_credentials grant, so the ID and secret are
# enough — there is no redirect step. The _OAUTH_ spelling is DigiKey's portal
# naming; blpl.agent.kicad_happy._CRED_MAP aliases it to the DIGIKEY_CLIENT_*
# names the scripts actually read.
DIGIKEY_OAUTH_CLIENT_ID=
DIGIKEY_OAUTH_CLIENT_SECRET=
# Not read at runtime. Kept because developer.digikey.com demands a redirect URI
# at registration, and a three-legged flow would need the real one.
DIGIKEY_CALLBACK_URL=

# Quoting needs only the search key. The orders key is passed through and
# currently unread — held for ordering work beyond what kicad-happy does.
MOUSER_SEARCH_API_KEY=
MOUSER_ORDERS_API_KEY=

ELEMENT14_API_KEY=

# --- Passkeys (optional, but set them in production) -------------------------
# The RP ID is the domain a passkey is bound to; the origin is where the app is
# served from. Unset, the server infers both from the browser's Origin header —
# fine for local development, and a dropped check in production.
#
# Changing BLPL_WEBAUTHN_RP_ID invalidates every passkey already enrolled, which
# presents to users as "my key stopped working" with no other clue. Pick it once.
BLPL_WEBAUTHN_RP_ID=blpl.example.com
BLPL_WEBAUTHN_ORIGIN=https://blpl.example.com
